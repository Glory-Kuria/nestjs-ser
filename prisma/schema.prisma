generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  Role      Role
  salary    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
enum Role {
    ADMIN
    ENGINEER
    INTERN
}